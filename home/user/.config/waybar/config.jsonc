{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "modules-left": [ "custom/menu", "hyprland/workspaces", "hyprland/mode"],
    "modules-center": ["clock"],
    "modules-right": [
        "cpu", 
        "memory", 
        "temperature", 
        "custom/clipboard", 
        "battery", 
        "wireplumber", 
        "bluetooth", 
        "network", 
        "tray", 
        "custom/power"
    ],

"custom/menu": {
    "format": "", // Здесь можно поставить любой символ, например   , , 🎯 или просто "Меню"
    "on-click": "wofi --show drun",
    "tooltip": false
},

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": 7
        },
        "format-icons": {
            "1": "Meow",
            "2": "Fox",
            "3": "MiCo",
            "4": "Amp",
            "5": "Fresh",
            "6": "Btop",
            "7": "Torr"
        }
    },

    "clock": {
        "format": " {:%H:%M   %d/%m/%Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": " {percentage}%"
    },

    "temperature": {
        "critical-threshold": 80,
        "format": " {temperatureC}°C"
    },

    "custom/clipboard": {
        "format": "  ",
        "on-click": "cliphist list | wofi --dmenu | cliphist decode | wl-copy",
        "tooltip": false
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "   {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["  ", "  ", "  ", "  ", "  ", "  ", "  ", "  ", "  ", "  ", "  "]
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "   Muted",
        "on-click": "pavucontrol",
        "format-icons": ["  ", "  ", "  "]
    },

    "bluetooth": {
        "format": " {status}",
        "format-disabled": "   off",
        "format-connected": " {num_connections}",
        "on-click": "blueman-manager"
    },

    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "   eth",
        "format-disconnected": "   Down",
        "on-click": "nm-connection-editor"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout -b 2",
        "tooltip": false
    }
}
